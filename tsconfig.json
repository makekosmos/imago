{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "paths": {
      "@core/*": ["./packages/core/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "env.d.ts",
    "index.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/**/*.vue"
  ]
}
