{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "paths": {
      "@core/*": ["./packages/core/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["env.d.ts", "index.ts", "packages/**/*.ts", "packages/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx"]
}
